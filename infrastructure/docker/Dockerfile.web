# Multi-stage Dockerfile for CourseCity Web App
FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@12.8.1 --activate

# Step 1: Install dependencies & build
FROM base AS builder
WORKDIR /app

# Copy root workspace configurations
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./

# Copy all workspace packages and apps so workspace lockfile matches exactly
COPY packages ./packages
COPY apps ./apps

# Install dependencies for workspace
RUN pnpm install --frozen-lockfile

# Build the web application
ENV NODE_ENV=production
RUN pnpm --filter @coursecity/web run build

# Step 2: Production runner
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Copy built project from builder
COPY --from=builder /app ./

EXPOSE 3000

# Start Next.js bound to 0.0.0.0 so external traffic reaches it
CMD ["pnpm", "--filter", "@coursecity/web", "run", "start", "-H", "0.0.0.0", "-p", "3000"]
