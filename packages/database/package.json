{
  "name": "@coursecity/database",
  "version": "1.0.0",
  "private": true,
  "description": "CourseCity Kysely database types, connection factory, and schema definitions",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "migrate:latest": "tsx src/cli.ts latest",
    "migrate:down": "tsx src/cli.ts down"
  },
  "dependencies": {
    "@coursecity/contracts": "workspace:*",
    "dotenv": "^16.4.7",
    "kysely": "^0.27.6",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
