# CourseCity 1.0 — Global Environment Variable Template
# Copy to .env in production / staging; NEVER commit secrets to git

# Node Environment
NODE_ENV=development
LOG_LEVEL=info

# Service URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
VERIFY_URL=http://localhost:3000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://coursecity_user:coursecity_dev_pass@localhost:5432/coursecity_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration (Cache, BullMQ, Rate Limiting)
REDIS_URL=redis://localhost:6379

# JWT & Authentication Secrets
JWT_ACCESS_SECRET=dev_jwt_access_secret_do_not_use_in_prod_minimum_32_chars_long
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_do_not_use_in_prod_minimum_32_chars_long
COOKIE_SECRET=dev_cookie_signing_secret_minimum_32_chars_long

# Ed25519 Cryptographic Keys for Receipts and Certificates (Base64url encoded 32-byte seed or 64-byte private key)
RECEIPT_SIGNING_PRIVATE_KEY_ED25519=dev_ed25519_private_key_placeholder
RECEIPT_SIGNING_PUBLIC_KEY_ED25519=dev_ed25519_public_key_placeholder
RECEIPT_SIGNING_KEY_ID=cc_ed25519_2026_v1

# Paystack Payment Provider Configuration
PAYSTACK_SECRET_KEY=sk_test_placeholder_for_local_development
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_for_local_development
PAYSTACK_WEBHOOK_SECRET=dev_paystack_webhook_signing_secret

# Object Storage (Cloudflare R2 / S3 Compatible)
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=dev_storage_access_key
STORAGE_SECRET_ACCESS_KEY=dev_storage_secret_key
STORAGE_BUCKET_NAME=coursecity-assets
STORAGE_PUBLIC_DOMAIN=https://assets.coursecity.com

# Transactional Email Provider
EMAIL_PROVIDER=mock
EMAIL_FROM_ADDRESS=noreply@coursecity.com
EMAIL_FROM_NAME="CourseCity"
EMAIL_API_KEY=dev_mock_key

# WhatsApp Business API
WHATSAPP_PROVIDER=mock
WHATSAPP_API_TOKEN=dev_whatsapp_mock_token
WHATSAPP_PHONE_NUMBER_ID=dev_phone_number_id
