{
  "name": "@coursecity/api",
  "version": "1.0.0",
  "private": true,
  "description": "CourseCity authoritative Fastify API server and OpenAPI 3.1 documentation",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
